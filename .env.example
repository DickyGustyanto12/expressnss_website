# =====================================================
# NSS Express Website — contoh konfigurasi environment
# Salin menjadi .env lalu isi nilainya:   cp .env.example .env
# JANGAN commit file .env (berisi rahasia).
# =====================================================

# ---------- Aplikasi ----------
# Port di server/host yang membuka website (container selalu di 3000)
APP_PORT=3000
# Zona waktu server & database (log, waktu default)
TZ=Asia/Jakarta

# Rahasia untuk token login admin (JWT). WAJIB diganti, min. 32 karakter acak.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang

# API key Google Gemini untuk chatbot AI (Google AI Studio → Get API key)
GEMINI_API_KEY=

# ---------- Database (MySQL) ----------
# Dengan docker-compose bawaan: biarkan DB_HOST=db (nama service MySQL).
# Jika memakai MySQL di luar Docker: isi host/IP server MySQL tersebut.
DB_HOST=db
DB_PORT=3306
DB_NAME=nss_express
DB_USER=nss_app
DB_PASSWORD=ganti-password-database
# Password root MySQL (hanya dipakai container MySQL bawaan)
DB_ROOT_PASSWORD=ganti-password-root
# Port MySQL di host, hanya terbuka untuk 127.0.0.1 (import data / Workbench)
DB_HOST_PORT=3307

# ---------- Tracking resi (server internal) ----------
# Server harus bisa menjangkau alamat ini (jaringan internal kantor / VPN)
TRACKING_API_URL=https://172.16.1.57/ksapisvr
# Server tracking memakai sertifikat self-signed → biarkan false.
# Isi true jika sertifikatnya sudah valid.
TRACKING_TLS_VERIFY=false
